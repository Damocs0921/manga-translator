# 复制本文件为 backend/.env 并填入你的 Gemini API Key
# 申请地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# 模型配置（主模型配额用尽时按 FALLBACK_MODELS 顺序自动切换）
DETECT_MODEL=gemini-3.8-flash
TRANSLATE_MODEL=gemini-3.8-flash
FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# PDF 拆页分辨率
PDF_DPI=200

# 译文渲染字体（留空则自动选择系统字体）
# FONT_PATH=/path/to/font.ttf
